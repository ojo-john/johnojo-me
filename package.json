{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:drafts": "SHOW_DRAFTS=1 next dev",
    "build": "next build",
    "postbuild": "node scripts/strip-local-media.mjs",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "media": "tsx scripts/media.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "status": "tsx scripts/status.ts",
    "check:links": "tsx scripts/check-links.ts",
    "media:upload": "tsx --conditions=react-server scripts/upload-media.ts",
    "media:backup": "tsx scripts/backup-originals.ts",
    "media:usage": "tsx scripts/storage-usage.ts",
    "media:pull": "tsx scripts/pull-originals.ts",
    "media:publish": "npm run media && npm run media:backup && npm run media:upload",
    "perf": "node scripts/perf.mts",
    "resume:pdf": "node scripts/resume-pdf.mts",
    "notes:sync": "python3 scripts/sync-notes.py"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "d3-geo": "^3.1.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@tailwindcss/turbopack": "^4",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vladmandic/face-api": "^1.7.15",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "exif-reader": "^2.0.3",
    "ffmpeg-static": "^5.2.0",
    "lighthouse": "^12.8.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.2.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "core-js": false
  }
}
